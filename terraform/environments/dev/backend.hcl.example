# Copy to backend.hcl (gitignored) and fill in real values, then:
#   terraform init -backend-config=backend.hcl
#
# Create the bucket/table once, before first init:
#   aws s3 mb s3://your-tfstate-bucket --region us-east-1
#   aws s3api put-bucket-versioning --bucket your-tfstate-bucket \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table \
#     --table-name your-lock-table \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST \
#     --region us-east-1

bucket         = "your-tfstate-bucket"
key            = "dev/us-east-1/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "your-lock-table"
encrypt        = true
